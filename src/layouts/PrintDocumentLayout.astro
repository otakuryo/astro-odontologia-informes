---
import '@fontsource-variable/manrope/wght.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/visual-themes.css';
import '../styles/print.css';
import '../styles/web.css';
import '../styles/legal.css';
import ClinicalHeader from '../components/document/ClinicalHeader.astro';
import DocumentFooter from '../components/document/DocumentFooter.astro';
import PrintToolbar from '../components/document/PrintToolbar.astro';
import SeoHead from '../components/web/SeoHead.astro';
import SiteFooter from '../components/web/SiteFooter.astro';
import { jsonLdFormat } from '../lib/site';

interface Props {
  title: string;
  description: string;
  documentTitle: string;
  code: string;
  revision?: string;
  page?: string;
}

const { title, description, documentTitle, code, revision = 'REV. 01', page = '1/1' } = Astro.props;
---

<!doctype html>
<html lang="es-ES" data-paper-size="letter" data-visual-theme="normal">
  <head>
    <script is:inline>
      (function () {
        var allowed = { letter: true, a5: true, a6: true };
        var param = new URLSearchParams(location.search).get('papel');
        var raw = param ? String(param).toLowerCase() : '';
        if (raw === 'carta') raw = 'letter';
        var size = allowed[raw] ? raw : '';
        if (!size) {
          try {
            var stored = localStorage.getItem('odo-paper-size');
            if (stored === 'carta') stored = 'letter';
            if (stored && allowed[stored]) size = stored;
          } catch (e) {}
        }
        document.documentElement.setAttribute('data-paper-size', size || 'letter');
      })();
    </script>
    <script is:inline>
      (function () {
        var aliases = {
          normal: 'normal',
          rounded: 'rounded',
          glass: 'glass',
          glassmorfismo: 'glass',
          redondeado: 'rounded',
        };
        var param = new URLSearchParams(location.search).get('estilo');
        var raw = param ? String(param).toLowerCase() : '';
        var theme = aliases[raw] || '';
        if (!theme) {
          try {
            var stored = localStorage.getItem('odo-visual-theme');
            if (stored) {
              stored = String(stored).toLowerCase();
              if (aliases[stored]) theme = aliases[stored];
            }
          } catch (e) {}
        }
        document.documentElement.setAttribute('data-visual-theme', theme || 'normal');
      })();
    </script>
    <script is:inline>
      (function () {
        function clampMm(raw) {
          if (raw == null || String(raw).trim() === '') return 0;
          var n = Number(String(raw).trim());
          if (!isFinite(n) || n < 0) return 0;
          n = Math.round(n);
          if (n === 0) return 0;
          if (n < 10) return 10;
          if (n > 15) return 15;
          return n;
        }
        function sideOf(raw) {
          if (!raw) return '';
          raw = String(raw).toLowerCase();
          if (raw === 'right' || raw === 'derecha') return 'right';
          if (raw === 'left' || raw === 'izquierda') return 'left';
          return '';
        }
        var params = new URLSearchParams(location.search);
        var mmParam = params.get('anillado');
        var mm = 0;
        if (mmParam !== null) {
          mm = clampMm(mmParam);
        } else {
          try {
            var storedMm = localStorage.getItem('odo-gutter-mm');
            if (storedMm != null) mm = clampMm(storedMm);
          } catch (e) {}
        }
        var side = sideOf(params.get('lomo'));
        if (!side) {
          try {
            var storedSide = localStorage.getItem('odo-gutter-side');
            side = sideOf(storedSide) || 'left';
          } catch (e) {
            side = 'left';
          }
        }
        var html = document.documentElement;
        if (mm > 0) {
          html.setAttribute('data-gutter-mm', String(mm));
        } else {
          html.removeAttribute('data-gutter-mm');
        }
        html.setAttribute('data-gutter-side', side || 'left');
      })();
    </script>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={Astro.url.pathname}
      jsonLd={jsonLdFormat()}
    />
  </head>
  <body class="is-print-document">
    <div class="web-chrome" data-theme="odo" data-print-hide>
      <PrintToolbar />
    </div>
    <div class="sheet-preview">
      <div class="sheet-preview__scaler">
        <div class="sheet" data-testid="sheet">
          <div class="sheet__inner">
            <ClinicalHeader title={documentTitle} />
            <main class="sheet__body">
              <slot />
            </main>
            <DocumentFooter code={code} revision={revision} page={page} />
          </div>
          <div class="sheet__gutter-guide" data-print-hide aria-hidden="true"></div>
        </div>
      </div>
    </div>
    <SiteFooter />
    <script is:inline>
      (function () {
        var sizes = { letter: 'letter portrait', a5: 'A5 portrait', a6: 'A6 portrait' };
        var size = document.documentElement.getAttribute('data-paper-size') || 'letter';
        var rule = sizes[size] || sizes.letter;
        var style = document.getElementById('print-page-size');
        if (!style) {
          style = document.createElement('style');
          style.id = 'print-page-size';
        }
        style.textContent = '@page { size: ' + rule + '; margin: 0; }';
        document.head.appendChild(style);
      })();
    </script>
  </body>
</html>
