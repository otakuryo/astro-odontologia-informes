---
import OutlinedPanel from '../document/OutlinedPanel.astro';
import ToothSprite from '../document/ToothSprite.astro';
import PerioArch from '../document/PerioArch.astro';
import PerioOcclusion from '../document/PerioOcclusion.astro';
import PerioSymbology from '../document/PerioSymbology.astro';
import type { DentitionId } from '../../lib/periodontogram';

interface Props {
  dentition?: DentitionId;
}

const { dentition = 'permanent' } = Astro.props;
const formatCode = dentition === 'temporal' ? 'ODO-F06' : 'ODO-F05';

const hallazgoLines = [
  { n: 1, label: 'P. ósea horizontal' },
  { n: 2, label: 'R. ósea vertical' },
  { n: 3, label: 'Ensanchamiento de espacio del lig. perio.' },
  { n: 4, label: 'Hallazgos Rx.' },
];
---

<div class="format" data-format={formatCode} data-dentition={dentition}>
  <ToothSprite dentition={dentition} />
  <PerioArch arch="upper" dentition={dentition} />
  <PerioOcclusion dentition={dentition} />
  <PerioArch arch="lower" dentition={dentition} />
  <h2 class="perio-exam-title">EXAMEN RADIOGRÁFICO</h2>
  <div class="perio-panels">
    <div class="perio-panel perio-panel--symbology" data-testid="perio-panel">
      <OutlinedPanel title="SIMBOLOGÍA">
        <PerioSymbology />
      </OutlinedPanel>
    </div>
    <div class="perio-panel perio-panel--hallazgos" data-testid="perio-panel">
      <OutlinedPanel title="HALLAZGOS RADIOGRÁFICOS">
        <div class="perio-notes perio-notes--hallazgos" data-count={hallazgoLines.length}>
          {
            hallazgoLines.map((line) => (
              <div class="perio-hallazgo" data-testid="perio-hallazgo">
                <span class="perio-hallazgo__label">{line.label}</span>
                <span class="notas-line" data-testid="perio-hallazgo-line" data-line={line.n}>
                  <span class="perio-hallazgo__mid" data-testid="perio-hallazgo-mid" aria-hidden="true"></span>
                </span>
              </div>
            ))
          }
        </div>
      </OutlinedPanel>
    </div>
  </div>
</div>

<style>
  .format {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: 0;
    height: 100%;
  }

  .perio-exam-title {
    font-family: var(--font-display);
    font-size: var(--fs-section);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-title);
    text-transform: uppercase;
    text-align: center;
    color: var(--ink);
    line-height: var(--lh-tight);
    flex: 0 0 auto;
  }

  .perio-panels {
    display: grid;
    grid-template-columns: var(--perio-panel-columns);
    gap: var(--space-2);
    height: var(--perio-panels-h);
    flex: 1 1 auto;
    min-height: 0;
    min-width: 0;
  }

  .perio-panel {
    min-width: 0;
    min-height: 0;
    height: 100%;
  }

  .perio-panel :global(.outlined-panel__body) {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .perio-panel :global(.outlined-panel__title) {
    font-size: var(--perio-panel-title-fs, var(--fs-section));
    padding-block: var(--perio-panel-title-pad-y, var(--panel-title-pad-y));
    letter-spacing: var(--perio-panel-title-tracking, var(--tracking-title));
  }

  .perio-panel--hallazgos :global(.outlined-panel__body) {
    padding-block: var(--perio-hallazgo-pad-y);
  }

  .perio-notes {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--perio-line-gap);
    height: 100%;
    min-height: 0;
    min-width: 0;
  }

  .perio-notes--hallazgos {
    justify-content: flex-start;
    gap: var(--perio-hallazgo-row-gap);
    padding-bottom: calc(var(--perio-hallazgo-mid-h) / 2);
  }

  .perio-hallazgo {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--perio-hallazgo-gap);
    min-width: 0;
    flex: 0 0 auto;
  }

  .perio-hallazgo__label {
    flex: 0 0 auto;
    font-family: var(--font-body);
    font-size: var(--perio-hallazgo-fs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--perio-hallazgo-tracking);
    text-transform: uppercase;
    color: var(--ink-muted);
    line-height: var(--lh-tight);
  }

  .notas-line {
    position: relative;
    display: block;
    width: 100%;
    flex: 1 1 auto;
    min-height: var(--space-1);
    border-bottom: var(--stroke-write) solid var(--ink);
  }

  .perio-hallazgo .notas-line {
    flex: 0 0 auto;
    min-height: 0;
  }

  .perio-hallazgo__mid {
    position: absolute;
    left: 50%;
    top: calc(100% + (var(--stroke-write) / 2));
    width: 0;
    height: var(--perio-hallazgo-mid-h);
    border-left: var(--stroke-rule) solid var(--ink);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
</style>
