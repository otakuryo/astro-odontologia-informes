---
import OutlinedPanel from '../document/OutlinedPanel.astro';
import LegendMarker from '../document/LegendMarker.astro';
import Odontogram from '../document/Odontogram.astro';

const legend = [
  { variant: 'rojo' as const, label: 'Rojo' },
  { variant: 'azul' as const, label: 'Azul' },
  { variant: 'verde' as const, label: 'Verde' },
  { variant: 'otro' as const, label: 'Otro' },
];
---

<div class="format" data-format="ODO-F04">
  <OutlinedPanel>
    <div class="imagen-doc">
      <div class="imagen-doc__diagrama">
        <Odontogram />
      </div>
      <ul class="leyenda" data-count="4">
        {
          legend.map((item) => (
            <li class="leyenda__item">
              <LegendMarker variant={item.variant} label={item.label} />
            </li>
          ))
        }
      </ul>
      <div class="imagen-doc__notas">
        <h2 class="imagen-doc__notas-title">NOTAS</h2>
        <div class="imagen-notas" data-testid="imagen-notas" aria-hidden="true"></div>
      </div>
    </div>
  </OutlinedPanel>
</div>

<style>
  .format {
    display: flex;
    flex-direction: column;
    min-height: 0;
    height: 100%;
  }

  .format :global(.outlined-panel__body) {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .imagen-doc {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-height: 0;
    height: 100%;
    flex: 1 1 auto;
  }

  .imagen-doc__diagrama {
    flex: 0 1 auto;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    min-height: 0;
    min-width: 0;
  }

  .leyenda {
    flex: 0 0 auto;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3) var(--space-6);
  }

  .leyenda__item {
    min-width: 0;
  }

  .imagen-doc__notas {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: var(--space-2);
    min-width: 0;
    min-height: 0;
  }

  .imagen-doc__notas-title {
    font-family: var(--font-display);
    font-size: var(--fs-section);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-title);
    color: var(--ink);
    line-height: var(--lh-tight);
  }

  .imagen-notas {
    flex: 1 1 auto;
    min-height: var(--imagen-notas-min);
    border: var(--stroke-inner) solid var(--cell-border-color);
    background: var(--cell-bg);
    border-radius: var(--radius-cell);
  }
</style>
