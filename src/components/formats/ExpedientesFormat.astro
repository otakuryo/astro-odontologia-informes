---
import OutlinedPanel from '../document/OutlinedPanel.astro';

const folios = [1, 2, 3, 4, 5];
---

<div class="format" data-format="ODO-F01">
  <OutlinedPanel title="FOLIOS" flush>
    <div class="folios" data-count="5">
      {
        folios.map((n) => (
          <div class="folios__row" data-testid="folio-row">
            <span class="folios__index">{n}</span>
            <span class="folios__area" aria-hidden="true"></span>
          </div>
        ))
      }
    </div>
  </OutlinedPanel>
</div>

<style>
  .format {
    display: flex;
    flex-direction: column;
    min-height: 0;
    height: 100%;
  }

  .folios {
    height: 100%;
    min-height: 0;
    display: grid;
    grid-template-rows: repeat(5, minmax(0, 1fr));
  }

  .folios__row {
    display: grid;
    grid-template-columns: 12mm minmax(0, 1fr);
    align-items: stretch;
    min-height: 0;
    min-width: 0;
    border-bottom: var(--stroke-inner) solid var(--ink);
  }

  .folios__row:last-child {
    border-bottom: none;
  }

  .folios__index {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: var(--fs-section);
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
    border-right: var(--stroke-inner) solid var(--ink);
    background: var(--fill-faint);
  }

  .folios__area {
    display: block;
    min-width: 0;
    min-height: 0;
  }
</style>
