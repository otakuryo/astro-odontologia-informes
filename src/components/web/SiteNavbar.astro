---
interface Props {
  homeLabel?: string;
}

const { homeLabel = 'Formatos odontológicos' } = Astro.props;
---

<div class="navbar bg-base-100 print-toolbar" data-testid="print-toolbar">
  <a class="btn btn-ghost btn-sm print-toolbar__home" href="/">{homeLabel}</a>
  <div class="print-toolbar__controls">
    <slot name="paper" />
    <div class="print-toolbar__actions">
      <slot name="download" />
      <slot name="print" />
      <slot name="options" />
    </div>
  </div>
</div>
