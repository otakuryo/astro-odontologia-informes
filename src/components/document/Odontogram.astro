---
import { buildOdontogramLayout, toothGlyph } from '../../lib/odontogram';

const layout = buildOdontogramLayout();
const viewBox = `0 0 ${layout.viewBox.w} ${layout.viewBox.h}`;
---

<svg
  class="odontogram"
  role="img"
  aria-label="Diagrama dental con notación FDI"
  data-testid="odontogram"
  viewBox={viewBox}
  preserveAspectRatio="xMidYMid meet"
>
  {
    layout.teeth.map((tooth) => {
      const glyph = toothGlyph(tooth.cx, tooth.cy);
      return (
        <g data-testid="tooth" data-fdi={tooth.fdi}>
          <circle
            class="odontogram__surface"
            cx={glyph.outer.cx}
            cy={glyph.outer.cy}
            r={glyph.outer.r}
            fill="var(--paper)"
          />
          <circle
            class="odontogram__surface"
            cx={glyph.inner.cx}
            cy={glyph.inner.cy}
            r={glyph.inner.r}
            fill="var(--paper)"
          />
          {glyph.rays.map((ray) => (
            <line class="odontogram__ray" x1={ray.x1} y1={ray.y1} x2={ray.x2} y2={ray.y2} />
          ))}
          <text
            class="odontogram__label"
            x={tooth.labelX}
            y={tooth.labelY}
            text-anchor="middle"
            dominant-baseline="middle"
            font-size="11"
          >
            {tooth.fdi}
          </text>
        </g>
      );
    })
  }
</svg>

<style>
  .odontogram {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    color: var(--ink);
    padding-inline: var(--space-3);
    padding-block: 0;
    box-sizing: border-box;
  }

  .odontogram__surface {
    fill: var(--paper);
    stroke: currentColor;
    stroke-width: var(--stroke-inner);
    vector-effect: non-scaling-stroke;
  }

  .odontogram__ray {
    fill: none;
    stroke: currentColor;
    stroke-width: var(--stroke-inner);
    vector-effect: non-scaling-stroke;
  }

  .odontogram__label {
    font-family: var(--font-display);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    fill: currentColor;
    stroke: none;
  }
</style>
