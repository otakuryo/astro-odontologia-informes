---
import ExportPanel from './ExportPanel.astro';
import ChromeIcon from '../web/ChromeIcon.astro';
import SiteNavbar from '../web/SiteNavbar.astro';
import ToolbarSelect from '../web/ToolbarSelect.astro';
import { VISUAL_THEMES } from '../../lib/visual-theme';
import { PAPER_PRESETS } from '../../scripts/paper-size';

interface Props {
  label?: string;
}

const { label = 'Imprimir hoja' } = Astro.props;
---

<SiteNavbar>
  <ToolbarSelect
    slot="theme"
    groupLabel="Estilo visual"
    testId="visual-theme-selector"
    icon="palette"
    options={VISUAL_THEMES}
    initialId="normal"
    optionAttr="data-visual-theme-option"
  />
  <ToolbarSelect
    slot="paper"
    groupLabel="Papel"
    testId="paper-size-selector"
    icon="file"
    options={Object.values(PAPER_PRESETS)}
    initialId="letter"
    optionAttr="data-paper-size-option"
  />
  <button slot="download" class="btn btn-primary btn-sm" type="button" data-testid="download-pdf">
    <ChromeIcon name="download" />
    <span class="print-toolbar__label" data-download-label>Descargar PDF</span>
  </button>
  <button slot="print" class="btn btn-ghost btn-sm" type="button" onclick="window.print()">
    <ChromeIcon name="printer" />
    <span class="print-toolbar__label">{label}</span>
  </button>
  <button slot="options" class="btn btn-sm" type="button" data-testid="export-options">
    <ChromeIcon name="settings" />
    <span class="print-toolbar__label">Opciones</span>
  </button>
</SiteNavbar>
<ExportPanel />

<script>
  import { bindPaperToolbar } from '../../scripts/paper-size';
  import { bindVisualThemeToolbar } from '../../scripts/visual-theme';
  import { bindPdfExport } from '../../scripts/export-pdf';

  bindPaperToolbar();
  bindVisualThemeToolbar();
  bindPdfExport();
</script>
