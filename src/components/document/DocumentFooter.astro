---
interface Props {
  code: string;
  revision?: string;
  page?: string;
}

const { code, revision = 'REV. 01', page = '1/1' } = Astro.props;
---

<footer class="document-footer">
  <span class="document-footer__code">{code}</span>
  <span class="document-footer__meta">{revision}</span>
  <span class="document-footer__page">{page}</span>
</footer>

<style>
  .document-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 100%;
    border-top: var(--stroke-inner) solid var(--ink);
    padding-top: 1.5mm;
    font-family: var(--font-display);
    font-size: var(--fs-meta);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .document-footer__code {
    color: var(--accent-teal);
    letter-spacing: 0.14em;
  }

  .document-footer__meta {
    text-align: center;
  }

  .document-footer__page {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
</style>
