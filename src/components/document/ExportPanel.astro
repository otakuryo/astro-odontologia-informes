---
import { FORMATS } from '../../lib/print-export/formats';

const designOptions = [
  { id: 'letter', label: 'Carta' },
  { id: 'a5', label: 'A5' },
  { id: 'a6', label: 'A6' },
] as const;

const paperOptions = [
  { id: 'letter', label: 'Carta' },
  { id: 'a4', label: 'A4' },
  { id: 'a5', label: 'A5' },
  { id: 'a6', label: 'A6' },
] as const;

const layoutOptions = [
  { id: '1up', label: '1-up (una por hoja)' },
  { id: 'duplicate', label: 'Duplicar' },
  { id: 'booklet', label: 'Cuadernillo' },
] as const;
---

<dialog id="export-panel" class="modal" data-testid="export-panel" aria-labelledby="export-panel-title">
  <div class="modal-box max-h-[90vh] overflow-y-auto">
    <h2 id="export-panel-title" class="text-lg font-bold">Exportar PDF</h2>
    <p class="py-2">
      El diseño es la hoja en pantalla. El papel es el tamaño de cada página del PDF. No se escala.
    </p>

    <div role="alert" class="alert hidden" data-testid="export-alert">
      <span data-export-alert-text></span>
    </div>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Diseño</legend>
      <div class="join" data-testid="export-design">
        {
          designOptions.map((option) => (
            <button
              class="join-item btn btn-sm"
              type="button"
              data-export-design={option.id}
              aria-pressed="false"
            >
              {option.label}
            </button>
          ))
        }
      </div>
      <p class="label">El mismo que Carta / A5 / A6 de la barra. A4 no es un diseño.</p>
    </fieldset>

    <fieldset class="fieldset" data-testid="export-paper">
      <legend class="fieldset-legend">Papel de salida</legend>
      <div class="join">
        {
          paperOptions.map((option) => (
            <button
              class="join-item btn btn-sm"
              type="button"
              data-export-paper={option.id}
              aria-pressed="false"
            >
              {option.label}
            </button>
          ))
        }
      </div>
    </fieldset>

    <fieldset class="fieldset" data-testid="export-layout">
      <legend class="fieldset-legend">Disposición</legend>
      {
        layoutOptions.map((option) => (
          <label class="label cursor-pointer justify-start gap-2">
            <input
              class="radio"
              type="radio"
              name="export-layout"
              data-export-layout={option.id}
            />
            <span>{option.label}</span>
            <span class="label hidden" data-layout-unavailable={option.id}>
              No aplica
            </span>
          </label>
        ))
      }
    </fieldset>

    <fieldset class="fieldset" data-testid="export-orientation">
      <legend class="fieldset-legend">Orientación</legend>
      <label class="label cursor-pointer justify-start gap-2">
        <input class="radio" type="radio" name="export-orientation" value="portrait" />
        <span>Vertical</span>
      </label>
      <label class="label cursor-pointer justify-start gap-2">
        <input class="radio" type="radio" name="export-orientation" value="landscape" />
        <span>Apaisado</span>
      </label>
      <p class="label hidden" data-orientation-auto>Automática (apaisado)</p>
    </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Formatos</legend>
      <p class="label">El formato de esta página parte marcado. No se puede dejar la lista vacía.</p>
      <ul class="flex flex-col gap-2" data-export-format-list>
        {
          FORMATS.map((format) => (
            <li class="flex items-center gap-2" data-format-id={format.id}>
              <label class="label flex-1 cursor-pointer justify-start gap-2">
                <input
                  class="checkbox"
                  type="checkbox"
                  data-testid="export-format"
                  data-format-id={format.id}
                />
                <span>{format.title}</span>
              </label>
              <button
                class="btn btn-square btn-xs"
                type="button"
                data-testid="export-format-up"
                aria-label={`Subir ${format.code}`}
              >
                ↑
              </button>
              <button
                class="btn btn-square btn-xs"
                type="button"
                data-testid="export-format-down"
                aria-label={`Bajar ${format.code}`}
              >
                ↓
              </button>
            </li>
          ))
        }
      </ul>
    </fieldset>

    <div class="modal-action">
      <form method="dialog">
        <button class="btn" type="submit">Cerrar</button>
      </form>
      <button class="btn btn-primary" type="button" data-testid="download-pdf-panel">
        <span class="loading loading-spinner hidden"></span>
        Descargar PDF
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button type="submit">Cerrar</button>
  </form>
</dialog>
