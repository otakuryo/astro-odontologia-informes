---
import { FORMATS } from '../../lib/print-export/formats';
import { GUTTER_DEFAULT_MM, GUTTER_MAX_MM, GUTTER_MIN_MM } from '../../lib/print-export/types';
import ChromeIcon from '../web/ChromeIcon.astro';

const designOptions = [
  { id: 'letter', label: 'Carta' },
  { id: 'a5', label: 'A5' },
  { id: 'a6', label: 'A6' },
] as const;

const paperOptions = [
  { id: 'letter', label: 'Carta' },
  { id: 'a4', label: 'A4' },
  { id: 'a5', label: 'A5' },
  { id: 'a6', label: 'A6' },
] as const;

const layoutOptions = [
  { id: '1up', label: '1-up (una por hoja)' },
  { id: 'duplicate', label: 'Duplicar' },
  { id: 'booklet', label: 'Cuadernillo' },
] as const;
---

<dialog id="export-panel" class="modal" data-testid="export-panel" aria-labelledby="export-panel-title">
  <div class="modal-box export-panel__box">
    <div class="export-panel__scroll">
      <h2 id="export-panel-title" class="text-lg font-bold">Exportar PDF</h2>
      <p class="py-2 text-sm leading-snug">
        El diseño es la hoja en pantalla. El papel es el tamaño de cada página del PDF. No se escala.
      </p>

      <div role="alert" class="alert hidden" data-testid="export-alert">
        <span data-export-alert-text></span>
      </div>

      <fieldset class="fieldset">
        <legend class="fieldset-legend">Diseño</legend>
        <div class="export-panel__fields">
          <div class="join" data-testid="export-design">
            {
              designOptions.map((option) => (
                <button
                  class="join-item btn btn-sm"
                  type="button"
                  data-export-design={option.id}
                  aria-pressed="false"
                >
                  {option.label}
                </button>
              ))
            }
          </div>
          <p class="fieldset-label">
            El mismo que Carta / A5 / A6 de la barra. A4 no es un diseño.
          </p>
        </div>
      </fieldset>

      <fieldset class="fieldset" data-testid="export-paper">
        <legend class="fieldset-legend">Papel de salida</legend>
        <div class="export-panel__fields">
          <div class="join">
            {
              paperOptions.map((option) => (
                <button
                  class="join-item btn btn-sm"
                  type="button"
                  data-export-paper={option.id}
                  aria-pressed="false"
                >
                  {option.label}
                </button>
              ))
            }
          </div>
        </div>
      </fieldset>

      <fieldset class="fieldset" data-testid="export-layout">
        <legend class="fieldset-legend">Disposición</legend>
        <div class="export-panel__fields">
          {
            layoutOptions.map((option) => (
              <label class="export-panel__choice">
                <input
                  class="radio radio-sm radio-primary"
                  type="radio"
                  name="export-layout"
                  data-export-layout={option.id}
                />
                <span>{option.label}</span>
                <span class="export-panel__hint hidden" data-layout-unavailable={option.id}>
                  No aplica
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="fieldset" data-testid="export-orientation">
        <legend class="fieldset-legend">Orientación</legend>
        <div class="export-panel__fields">
          <label class="export-panel__choice">
            <input class="radio radio-sm radio-primary" type="radio" name="export-orientation" value="portrait" />
            <span>Vertical</span>
          </label>
          <label class="export-panel__choice">
            <input class="radio radio-sm radio-primary" type="radio" name="export-orientation" value="landscape" />
            <span>Apaisado</span>
          </label>
          <p class="export-panel__hint hidden" data-orientation-auto>Automática (apaisado)</p>
        </div>
      </fieldset>

      <fieldset class="fieldset" data-testid="export-gutter">
        <legend class="fieldset-legend">Anillado</legend>
        <div class="export-panel__fields">
          <label class="export-panel__choice">
            <input
              class="checkbox checkbox-sm checkbox-primary"
              type="checkbox"
              data-export-gutter-enabled
            />
            <span>Activar</span>
          </label>
          <label class="export-panel__gutter-mm">
            <input
              class="range range-sm range-primary"
              type="range"
              min={GUTTER_MIN_MM}
              max={GUTTER_MAX_MM}
              step="1"
              value={GUTTER_DEFAULT_MM}
              data-export-gutter-mm
              aria-label="Milímetros de anillado"
            />
            <output data-export-gutter-value>{GUTTER_DEFAULT_MM} mm</output>
          </label>
          <label class="export-panel__choice">
            <input
              class="radio radio-sm radio-primary"
              type="radio"
              name="export-gutter-side"
              value="left"
            />
            <span>Izquierda</span>
          </label>
          <label class="export-panel__choice">
            <input
              class="radio radio-sm radio-primary"
              type="radio"
              name="export-gutter-side"
              value="right"
            />
            <span>Derecha</span>
          </label>
          <p class="export-panel__hint hidden" data-gutter-booklet-auto>
            Hacia el pliegue, automático
          </p>
          <p class="fieldset-label">
            A doble cara: en 1-up con varios formatos las páginas pares llevan el lomo al lado
            contrario. También aplica a Imprimir hoja y a la vista en pantalla. No aplica a PNG
            para editar.
          </p>
        </div>
      </fieldset>

      <fieldset class="fieldset">
        <legend class="fieldset-legend">Formatos</legend>
        <div class="export-panel__fields">
          <p class="fieldset-label">
            El formato de esta página parte marcado. No se puede dejar la lista vacía.
          </p>
          <p class="fieldset-label">
            PNG para editar descarga un ZIP con un PNG por formato marcado, sin fondo de hoja. El
            papel de salida, la disposición y la orientación aplican solo al PDF.
          </p>
          <ul class="export-panel__formats" data-export-format-list>
            {
              FORMATS.map((format) => (
                <li data-format-id={format.id}>
                  <label class="export-panel__choice export-panel__choice--grow">
                    <input
                      class="checkbox checkbox-sm checkbox-primary"
                      type="checkbox"
                      data-testid="export-format"
                      data-format-id={format.id}
                    />
                    <span>{format.title}</span>
                  </label>
                  <button
                    class="btn btn-square btn-sm shrink-0"
                    type="button"
                    data-testid="export-format-up"
                    aria-label={`Subir ${format.code}`}
                  >
                    <ChromeIcon name="chevron-up" />
                  </button>
                  <button
                    class="btn btn-square btn-sm shrink-0"
                    type="button"
                    data-testid="export-format-down"
                    aria-label={`Bajar ${format.code}`}
                  >
                    <ChromeIcon name="chevron-down" />
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
      </fieldset>
    </div>

    <div class="modal-action">
      <form method="dialog">
        <button class="btn btn-sm" type="submit">Cerrar</button>
      </form>
      <button class="btn btn-ghost btn-sm" type="button" data-testid="download-png-panel">
        <ChromeIcon name="image" />
        <span data-download-label data-download-idle="PNG para editar">PNG para editar</span>
      </button>
      <button class="btn btn-primary btn-sm" type="button" data-testid="download-pdf-panel">
        <ChromeIcon name="download" />
        <span data-download-label data-download-idle="Descargar PDF">Descargar PDF</span>
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button type="submit" aria-label="Cerrar el panel"></button>
  </form>
</dialog>
