---
import '@fontsource-variable/manrope/wght.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/print.css';
import '../styles/web.css';
import SeoHead from '../components/web/SeoHead.astro';
import {
  CATALOG_FORMATS,
  FAQ_ITEMS,
  SITE_DEFINITION,
  SITE_DESCRIPTION,
  SITE_H1,
  SITE_NAME,
  SITE_TITLE,
  jsonLdCatalog,
} from '../lib/site';
---

<!doctype html>
<html lang="es-ES">
  <head>
    <SeoHead
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      canonicalPath={Astro.url.pathname}
      jsonLd={jsonLdCatalog()}
    />
  </head>
  <body class="is-catalog">
    <div class="catalog">
      <header class="catalog__intro">
        <img class="catalog__logo" src="/logo.png" alt="" width="108" height="72" />
        <p class="catalog__kicker">{SITE_NAME}</p>
        <h1 class="catalog__title">{SITE_H1}</h1>
        <p class="catalog__note">{SITE_DEFINITION}</p>
      </header>
      <div class="web-chrome" data-theme="odo" data-print-hide>
        <nav class="catalog__nav" aria-label="Formatos clínicos">
          <ul class="catalog__list">
            {
              CATALOG_FORMATS.map((format, index) => (
                <li>
                  <a class="btn btn-lg btn-block" href={format.href}>
                    <span class="catalog__index">{String(index + 1).padStart(2, '0')}</span>
                    <span class="catalog__copy">
                      <span class="catalog__code">{format.code}</span>
                      <span class="catalog__name">{format.title}</span>
                      <span class="catalog__lead">{format.lead}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <section class="catalog__faq">
        {
          FAQ_ITEMS.map((item) => (
            <article>
              <h2>{item.question}</h2>
              <p class="catalog__note">{item.answer}</p>
            </article>
          ))
        }
      </section>
    </div>
  </body>
</html>

<style>
  .catalog {
    max-width: 920px;
    margin: 0 auto;
    padding: 48px 24px 72px;
  }

  .catalog__logo {
    height: 72px;
    width: auto;
    margin-bottom: 16px;
    border-radius: 12px;
  }

  .catalog__kicker {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-teal);
    margin-bottom: 10px;
  }

  .catalog__title {
    font-size: 36px;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }

  .catalog__note {
    color: var(--ink-muted);
    font-size: 16px;
  }

  .catalog__list {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .catalog__list .btn {
    height: auto;
    min-height: 5.5rem;
    white-space: normal;
    justify-content: flex-start;
    gap: 14px;
  }

  .catalog__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    text-align: start;
    gap: 2px;
  }

  .catalog__index {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: var(--fw-bold);
    color: var(--accent-coral);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .catalog__code {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-teal);
  }

  .catalog__name {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: var(--fw-bold);
    color: var(--ink);
  }

  .catalog__lead {
    font-size: 15px;
    font-weight: var(--fw-regular);
    color: var(--ink-muted);
  }

  .catalog__faq {
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .catalog__faq h2 {
    font-size: 20px;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }

  @media (max-width: 720px) {
    .catalog__list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .catalog {
      padding: 24px;
    }

    .catalog__title {
      font-size: 28px;
    }
  }

  @media print {
    .catalog {
      display: none !important;
    }
  }
</style>
